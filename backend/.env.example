# For running the backend directly on Windows while Docker PostgreSQL maps host port 5433.
# If PostgreSQL runs locally on 5432, change the port below to 5432.
DATABASE_URL="postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5433/sweety_db?schema=public"

# Keep this separate from DATABASE_URL. Tests must never use the app database.
TEST_DATABASE_URL="postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5433/sweety_test?schema=public"

# Generate two different random values of at least 32 characters for production.
ACCESS_TOKEN_SECRET="replace_with_a_unique_random_secret_at_least_32_chars"
REFRESH_TOKEN_SECRET="replace_with_a_different_random_secret_at_least_32_chars"

ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

PORT=7005
# For multiple frontend domains, separate exact origins with commas.
CLIENT_URL=http://localhost:5173
NODE_ENV=development

APP_TIMEZONE=Asia/Kolkata
BCRYPT_SALT_ROUNDS=12
